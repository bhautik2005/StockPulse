# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Matches docker-compose.yml:  docker compose up -d --wait
# The database name is case-sensitive -- "StockPulse", not "stockpulse".
DATABASE_URL=postgres://bhautik:bhautik@127.0.0.1:5432/StockPulse
#
# Without Docker, use the bundled PostgreSQL instead: uncomment this, comment
# the line above, and run `npm run db:up`.
# DATABASE_URL=postgres://postgres@127.0.0.1:55432/stockpulse

DB_POOL_MAX=10
# Global guards: a stuck query or lock must never hold a pool slot forever.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# ---- Auth ----
# Must be >= 32 chars. The app refuses to boot with a weak or missing secret.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=15m
COOKIE_NAME=sp_token
CSRF_COOKIE_NAME=sp_csrf
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ---- HTTP ----
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Password reset ----
# The base URL used to build the emailed reset link. Trusted config, never the
# request's Host header. No trailing slash.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30

# Reset throttles. Two buckets: per caller address, and per targeted account.
# Raise the IP cap behind a shared NAT without loosening the account cap.
RESET_RATE_IP_MAX=5
RESET_RATE_IP_WINDOW_MS=900000
RESET_RATE_ACCOUNT_MAX=3
RESET_RATE_ACCOUNT_WINDOW_MS=3600000

# ---- Transactional email (Gmail SMTP) ----
# EMAIL_PASS must be a Google App Password, not the account password: Gmail
# rejects plain-password SMTP auth. Optional -- the API boots without it, and
# reset emails are simply reported as undelivered in the log.
EMAIL_USER=
EMAIL_PASS=
# Optional override; defaults to "StockPulse <EMAIL_USER>".
EMAIL_FROM=

# ---- Business rules ----
ORDER_MAX_LINES=200
ORDER_MAX_QUANTITY_PER_LINE=100000